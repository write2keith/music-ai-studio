# =============================================================================
# Music AI Studio - Backend Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values
# Never commit .env to version control

# --- Server ---
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000

# --- Database (PostgreSQL via Prisma) ---
# Required: PostgreSQL 14+. Create the database first:
#   createdb music_ai
# Then run: prisma migrate dev
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/music_ai

# --- Redis (Async Queue) ---
# Required: Redis 6+. Install and start:
#   redis-server
# The queue offloads MusicGen generation and Demucs separation
# so HTTP requests don't time out during long-running AI tasks
REDIS_URL=redis://localhost:6379/0

# --- Authentication (BetterAuth) ---
# Generate a secure secret: openssl rand -hex 32
AUTH_SECRET=change-me-in-production-use-a-64-char-random-string

# Google OAuth (https://console.cloud.google.com/apis/credentials)
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=

# GitHub OAuth (https://github.com/settings/developers)
AUTH_GITHUB_CLIENT_ID=
AUTH_GITHUB_CLIENT_SECRET=

# --- AI Models ---
# HuggingFace token for gated model access (https://huggingface.co/settings/tokens)
HF_TOKEN=

# LLM for prompt enhancement (OpenAI-compatible API)
# When set, the "Enhance with AI" button calls your LLM to improve prompts
# When empty, a rule-based fallback enhancer is used
USER_LLM_API_KEY=
USER_LLM_BASE_URL=https://api.deepseek.com/v1
USER_LLM_MODEL=deepseek-chat

# MusicGen model size: small (fastest), medium, large (best quality)
# small: ~1.5GB VRAM, medium: ~5GB, large: ~8GB
MUSICGEN_MODEL_SIZE=small
MUSICGEN_DURATION=10

# --- Cloud Storage (S3-compatible: AWS S3 / Cloudflare R2) ---
# local: files stored on disk under ./output/
# s3: files uploaded to S3 bucket
STORAGE_PROVIDER=local
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Serverless GPU Execution (Modal.com) ---
# For running heavy models on serverless GPUs instead of local
# https://modal.com/settings
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
MODAL_ENVIRONMENT=dev

# --- Payments (Stripe) ---
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe Price IDs for subscription tiers
# Create products/prices at https://dashboard.stripe.com/products
STRIPE_PRICE_ID_BASIC=
STRIPE_PRICE_ID_PRO=

# --- File Storage ---
MAX_UPLOAD_SIZE_MB=100
FILE_RETENTION_HOURS=24

# --- Rate Limiting ---
RATE_LIMIT_GENERATIONS_PER_HOUR=20
RATE_LIMIT_SEPARATIONS_PER_HOUR=50
FREE_TIER_CREDITS=10
